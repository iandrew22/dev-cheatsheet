{
  "$description": "Savas Labs design tokens. Source: plugins/savas deck-kit themes/savas.css (extracted 2026-09-17, white paper as of 2026-09-19), plus type/radius/spacing values observed in the Savas cheatsheet and Q2 2026 report. Format follows the W3C Design Tokens spec so Figma Variables, Tokens Studio and Style Dictionary can all read it.",
  "color": {
    "paper": {
      "white": { "$type": "color", "$value": "#FFFFFF", "$description": "Default page and slide background" },
      "warm":  { "$type": "color", "$value": "#FEFBF4", "$description": "Website warm paper" },
      "cream": { "$type": "color", "$value": "#FBF3E4", "$description": "Callouts and quiet panels" }
    },
    "neutral": {
      "ink":      { "$type": "color", "$value": "#1A1D2E", "$description": "Primary text, dark surfaces" },
      "graphite": { "$type": "color", "$value": "#3D4256", "$description": "Body copy" },
      "mute":     { "$type": "color", "$value": "#8C8E9E", "$description": "Captions, eyebrows. Large text only on white" }
    },
    "accent": {
      "mint":        { "$type": "color", "$value": "#3EE0C5", "$description": "Signature accent. Fills, highlights, selection" },
      "mint-ink":    { "$type": "color", "$value": "#2BA48F", "$description": "Rules and large text only (2.98:1 on white)" },
      "mint-text":   { "$type": "color", "$value": "#216963", "$description": "Mint dark enough for small text (AA)" },
      "coral":       { "$type": "color", "$value": "#FF5A42", "$description": "Flourish, emphasis. Fills" },
      "coral-text":  { "$type": "color", "$value": "#B5301A", "$description": "Coral dark enough for small text (AA)" },
      "marigold":    { "$type": "color", "$value": "#FFB020" },
      "lavender":    { "$type": "color", "$value": "#C77DFF" },
      "ojo-blue":    { "$type": "color", "$value": "#00A6FB", "$description": "Ojo product accent" }
    },
    "line": {
      "default": { "$type": "color", "$value": "#1A1D2E24", "$description": "ink @ 14%" },
      "strong":  { "$type": "color", "$value": "#1A1D2E47", "$description": "ink @ 28%" },
      "subtle":  { "$type": "color", "$value": "#1A1D2E1F", "$description": "ink @ 12% (cheatsheet borders)" },
      "wash":    { "$type": "color", "$value": "#1A1D2E0F", "$description": "ink @ 6% (table headers, code chips)" }
    },
    "on": {
      "mint":     { "$type": "color", "$value": "{color.neutral.ink}" },
      "coral":    { "$type": "color", "$value": "{color.neutral.ink}" },
      "marigold": { "$type": "color", "$value": "{color.neutral.ink}" },
      "lavender": { "$type": "color", "$value": "{color.neutral.ink}" }
    }
  },
  "font": {
    "family": {
      "sans":  { "$type": "fontFamily", "$value": "Manrope" },
      "serif": { "$type": "fontFamily", "$value": "PT Serif" },
      "mono":  { "$type": "fontFamily", "$value": "SF Mono" }
    },
    "weight": {
      "regular":   { "$type": "fontWeight", "$value": 400 },
      "medium":    { "$type": "fontWeight", "$value": 500 },
      "semibold":  { "$type": "fontWeight", "$value": 600 },
      "bold":      { "$type": "fontWeight", "$value": 700 },
      "extrabold": { "$type": "fontWeight", "$value": 800 }
    }
  },
  "type": {
    "$description": "Composite text styles. Sizes in px at 16px root.",
    "display":   { "family": "sans",  "size": 38, "weight": 800, "lineHeight": 1.2,  "tracking": -0.02, "sample": "Digital that works" },
    "h2":        { "family": "sans",  "size": 38, "weight": 700, "lineHeight": 1.1,  "tracking": -0.025, "sample": "Section heading" },
    "h3":        { "family": "sans",  "size": 24, "weight": 600, "lineHeight": 1.1,  "tracking": -0.015, "sample": "Subsection heading" },
    "h4":        { "family": "sans",  "size": 16, "weight": 700, "lineHeight": 1.3,  "tracking": -0.01,  "sample": "Card title" },
    "body":      { "family": "sans",  "size": 17, "weight": 400, "lineHeight": 1.55, "tracking": 0,      "sample": "Body copy is set in Manrope, graphite on white, at a comfortable reading measure." },
    "body-sm":   { "family": "sans",  "size": 14, "weight": 500, "lineHeight": 1.6,  "tracking": 0,      "sample": "Secondary copy and table cells." },
    "eyebrow":   { "family": "sans",  "size": 12.5, "weight": 700, "lineHeight": 1.2, "tracking": 0.18,  "transform": "uppercase", "sample": "Small caps eyebrow" },
    "label":     { "family": "sans",  "size": 10.5, "weight": 800, "lineHeight": 1.2, "tracking": 0.12,  "transform": "uppercase", "sample": "Group label" },
    "flourish":  { "family": "serif", "size": 19,  "weight": 400, "lineHeight": 1.3,  "tracking": -0.02, "italic": true, "sample": "with a little serif italic" },
    "code":      { "family": "mono",  "size": 13,  "weight": 400, "lineHeight": 1.5,  "tracking": 0,      "sample": "git push origin main" }
  },
  "radius": {
    "xs":   { "$type": "dimension", "$value": "4px",  "$description": "Code chips" },
    "sm":   { "$type": "dimension", "$value": "8px",  "$description": "Icon tiles" },
    "md":   { "$type": "dimension", "$value": "10px" },
    "lg":   { "$type": "dimension", "$value": "16px", "$description": "Cards and sections" },
    "full": { "$type": "dimension", "$value": "9999px", "$description": "Pills and dots" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "shadow": {
    "1": { "$type": "shadow", "$value": "0 1px 3px rgba(26,29,46,0.06), 0 4px 16px rgba(26,29,46,0.05)" },
    "2": { "$type": "shadow", "$value": "0 8px 30px rgba(26,29,46,0.10), 0 2px 6px rgba(26,29,46,0.05)" }
  },
  "breakpoint": {
    "phone":  { "$type": "dimension", "$value": "600px", "$description": "Stacked layout below this" },
    "page":   { "$type": "dimension", "$value": "860px", "$description": "Max content width" }
  }
}
